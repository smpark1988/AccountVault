<Window x:Class="AccountVault.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccountVault 초기 설정"
        Width="500"
        Height="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Width="390"
                Padding="26"
                Style="{StaticResource PanelBorder}"
                Effect="{StaticResource CardShadow}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>
                <Border Width="44"
                        Height="44"
                        CornerRadius="8"
                        Background="{StaticResource AccentSoftBrush}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE8D7;"
                               FontSize="20"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="새 보관함 만들기"
                           Style="{StaticResource PageTitleText}" />
                <TextBlock Text="계정 데이터는 이 장치에만 암호화되어 저장됩니다."
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,22" />

                <TextBlock Text="마스터 비밀번호"
                           Style="{StaticResource LabelText}" />
                <PasswordBox x:Name="MasterPasswordBox"
                             PasswordChar="●"
                             Margin="0,0,0,14" />

                <TextBlock Text="마스터 비밀번호 확인"
                           Style="{StaticResource LabelText}" />
                <PasswordBox x:Name="ConfirmPasswordBox"
                             PasswordChar="●"
                             KeyDown="PasswordBox_KeyDown" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,10"
                           MinHeight="20" />

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="CreateButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" />
                        <TextBlock Text="생성" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
