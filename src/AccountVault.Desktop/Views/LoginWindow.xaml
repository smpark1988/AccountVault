<Window x:Class="AccountVault.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccountVault 로그인"
        Icon="/AccountVault;component/Assets/AccountVault.ico"
        Width="460"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Width="360"
                Padding="26"
                Style="{StaticResource PanelBorder}"
                Effect="{StaticResource CardShadow}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>
                <Image Source="/AccountVault;component/Assets/AccountVault.png"
                       Width="44"
                       Height="44"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,16"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="AccountVault" />

                <TextBlock Text="AccountVault"
                           Style="{StaticResource PageTitleText}" />
                <TextBlock Text="마스터 비밀번호로 보관함을 엽니다."
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,22" />

                <TextBlock Text="마스터 비밀번호"
                           Style="{StaticResource LabelText}" />
                <PasswordBox x:Name="MasterPasswordBox"
                             PasswordChar="●"
                             KeyDown="PasswordBox_KeyDown" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,10"
                           MinHeight="20" />

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        MinHeight="40"
                        Click="UnlockButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A7;" />
                        <TextBlock Text="열기" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
