<Window x:Class="AccountVault.Views.AccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="600"
        Height="720"
        MinWidth="520"
        MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Margin="22"
                Padding="22"
                Style="{StaticResource PanelBorder}"
                Effect="{StaticResource CardShadow}">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,16"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="{Binding WindowTitle}"
                                   Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="사이트명은 필수이며, 아이디 또는 비밀번호 중 하나 이상을 입력하세요."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <Button Content="취소"
                            Width="86"
                            IsCancel="True" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Width="86"
                            IsDefault="True"
                            Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74E;" />
                            <TextBlock Text="저장" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="사이트명 *" Style="{StaticResource LabelText}" />
                        <TextBox Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Text="URL" Style="{StaticResource LabelText}" />
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="아이디" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="비밀번호" Style="{StaticResource LabelText}" />
                            <PasswordBox x:Name="PasswordBox"
                                         PasswordChar="●" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Text="메모"
                               Style="{StaticResource LabelText}" />
                    <TextBox Grid.Row="4"
                             Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="150"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12" />

                    <TextBlock Grid.Row="5"
                               Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               MinHeight="22" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
